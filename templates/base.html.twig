<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Page d'accueil{% endblock %}</title>
    <link rel="icon" href="{{ asset('images/favicon.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800;900&family=Fredoka+One&family=Science+Gothic:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {{ importmap('app') }}
        <script type="module" src="{{ asset('js/shared_body.js') }}"></script>
    {% endblock %}
</head>
<body data-theme="standard">
{% include 'structure/header.html.twig' %}
{% include 'structure/shared_body.html.twig' %}

<main>
    {% block body %}{% endblock %}
</main>
 {% include 'structure/footer.html.twig' %}


{# --- 1. MODALE MERCURE GLOBALE (HTML) --- #}
<div id="push-notification-modal" class="push-modal" hidden role="dialog" aria-modal="true">
    <div class="push-modal-content" id="push-modal-content">
        <button id="btn-close-push" class="push-close" aria-label="Fermer">✕</button>
        <h2 id="push-title" class="push-title">Alerte</h2>
        <p id="push-message" class="push-message"></p>
        <p id="push-times" class="push-times" style="font-weight: bold; margin-top: 15px; color: #333;"></p>
        <p id="push-countdown" class="push-countdown" style="font-size: 1.5rem; font-weight: bold; color: #dc3545;"></p>
        <button id="push-action-btn" class="push-action-btn" style="display: block !important; visibility: visible !important; opacity: 1 !important; background-color: red !important; color: white !important; font-size: 20px; padding: 20px;">
            BOUTON TEST FORCE
        </button>    </div>
</div>
{# --- 2. SCRIPT MERCURE GLOBAL (JS) --- #}


<script type="module" src="{{ asset('js/notifications.js') }}"></script>

{# --- FIN MODALE MERCURE --- #}



 {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ACCOMPANYING') %}
    <script>
        // Pour l'instant, j'ai pas trouvé de bonne méthode pour faire une déconnexion autre
        // que celle là, j'ai essayé de mettre le .js ailleurs pour mieux compartimenter mais
        // le navigateur ne recoit jamais à cause d'un conflit avec l'assetMapper.

        (function() {
            console.log(" Système de sécurité (Timeout) activé !");

            const logoutUrl = '{{ path('app_logout') }}';
            // Pour le test : 60 secondes pour tout le monde
            const timeoutMs = 3600000;

            let idleTimer;

            function resetIdleTimer(e) {
                clearTimeout(idleTimer);
                // Pour tester les events en dessous
                console.log("Activité détectée : Timer remis à zéro !");

                idleTimer = setTimeout(() => {
                    console.log("Temps écoulé ! Déconnexion...");
                    window.location.replace(logoutUrl);
                }, timeoutMs);
            }

            const events = ['mousemove', 'keydown', 'mousedown','wheel', 'scroll', 'touchstart', 'touchmove',];
            events.forEach(evt => {
                window.addEventListener(evt, resetIdleTimer, true);
            });

            // Ca lance le minuteur au chargement de la page
            resetIdleTimer();
        })();
    </script>
{% endif %}

</body>
</html>
