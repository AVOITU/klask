{% extends 'base.html.twig' %}

{% block title %}Bienvenue{% endblock %}


{% block body %}
<div class="hud-window">

    <div class="hud-cap">
        <h1>Bienvenue<span style="--len:{{ pseudo|length }}">{{ pseudo }}</span></h1>
    </div>

    <div class="hud-body">
        <div class="welcome-card">

            <span class="avatar avatar--lg">
                <img
                    src="{{ asset(avatar(pseudo)) }}"
                    alt="Avatar de {{ pseudo }}"
                >
            </span>

            <div class="welcome-score">
                Score&nbsp;: <strong>0</strong> pt
            </div>

            <a href="{{ path('app_questionnaire') }}" class="btn-continuer">
                Continuer
            </a>

        </div>
    </div>

</div>
{% endblock %}
