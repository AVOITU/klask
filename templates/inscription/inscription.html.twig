{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/inscription.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/shared_body.js') }}"></script>
{% endblock %}

{% block body %}
    <div class="container">
        <h1>Création de profil</h1>

{#        {% if app.flashes %}#}
             Messages
            <div class="resultat success-anim">
                <h3>🎉 Inscription Validée !</h3>
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        👤 <strong> {{ message }} </strong>
                    {% endfor %}
                {% endfor %}
            </div>
{#        {% endif %}#}

        <form method="post" action="{{ path('app_inscription') }}">
            <input type="hidden" name="form_action" value="{{ form_action|default('save') }}">

            {# 1) ECOLE #}
            <div class="form-group">
                <label for="choix_ecole">1. Mon Établissement</label>

                <div class="select-wrapper">
                    <select id="choix_ecole"
                            name="ecole"
                            onchange="this.form.form_action.value='schoolChange'; this.form.submit()">
                        <option value="">👇 Touchez pour choisir</option>

                        {% for school in schools %}
                            <option value="{{ school|e }}"
                                    {% if selectedSchool is not empty and selectedSchool == school %}selected{% endif %}>
                                {{ school|e }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            {# 2) CLASSE #}
            <div class="form-group">
                <label for="choix_classe">2. Ma Classe</label>

                <div class="select-wrapper">
                    <select name="classe_final_id" id="choix_classe" required>
                        {% if filteredClasses is empty %}
                            <option value="" selected disabled>
                                🔒 Choisissez d'abord l'école
                            </option>
                        {% else %}
                            <option value="" disabled {% if selectedClassId == 0 %}selected{% endif %}>
                                👇 Choisir la classe
                            </option>

                            {% for classe in filteredClasses %}
                                <option value="{{ classe.id_class }}"
                                        {% if selectedClassId == classe.id_class %}selected{% endif %}>
                                    {{ classe.name_class|e }}
                                </option>
                            {% endfor %}
                        {% endif %}
                    </select>
                </div>
            </div>

            {# 3) PSEUDO #}
            <div class="form-group">
                <label>3. Mon identité secrète</label>

                <div class="identity-box">
                    <input type="text"
                           name="pseudo_choisi"
                           id="pseudo_input"
                           value="{{ nom_depart|e }}"
                           readonly>

                    <button type="submit" name="form_action" value="regen" id="btn_random">🎲</button>
                </div>

                <small>Touchez le dé pour changer</small>
            </div>

            <input type="submit" value="Valider l'inscription">
        </form>
    </div>
{% endblock %}
