{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/inscription.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/shared_body.js') }}"></script>
{% endblock %}

{% block body %}
    <div class="container">
        <h1>Création de profil</h1>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="resultat {{ label == 'success' ? 'success-anim' : 'error-anim' }}">
                    <h3>
                        {% if label == 'success' %}
                            🎉 Inscription validée !
                        {% else %}
                            ⚠️ Erreur
                        {% endif %}
                    </h3>
                    <p><strong>{{ message }}</strong></p>
                </div>
            {% endfor %}
        {% endfor %}

        {{ form_start(inscriptionForm, {
            action: path('app_inscription_save'),
            method: 'POST',
            attr: {
                'data-turbo': 'false'
            }
        }) }}

        <div class="form-group">
            {{ form_label(inscriptionForm.establishment, '1. Mon Établissement', {
                label_attr: { for: 'inscription_form_establishment' }
            }) }}

            <div class="select-wrapper">
                {{ form_widget(inscriptionForm.establishment, {
                    attr: {
                        onchange: "this.form.action='" ~ path('app_inscription_establishment_change') ~ "'; this.form.submit();"
                    }
                }) }}
            </div>

            {{ form_errors(inscriptionForm.establishment) }}
        </div>

        <div class="form-group">
            {{ form_label(inscriptionForm.group, '2. Mon groupe', {
                label_attr: { for: 'inscription_form_group' }
            }) }}

            <div class="select-wrapper">
                {{ form_widget(inscriptionForm.group) }}
            </div>

            {{ form_errors(inscriptionForm.group) }}
        </div>

        <div class="form-group">
            {{ form_label(inscriptionForm.pseudoUser, '3. Mon identité secrète') }}

            <div class="identity-box">
                {{ form_widget(inscriptionForm.pseudoUser, {
                    attr: {
                        id: 'pseudo_input',
                        readonly: 'readonly',
                    }
                }) }}

                <button
                    type="submit"
                    id="btn_random"
                    formaction="{{ path('app_inscription_regen') }}"
                    formmethod="POST"
                >
                    🎲
                </button>
            </div>

            <small>Touchez le dé pour changer</small>
            {{ form_errors(inscriptionForm.pseudoUser) }}
        </div>

        <input type="submit" value="Valider l'inscription">

        {{ form_end(inscriptionForm) }}
    </div>
{% endblock %}
