{% extends 'base.html.twig' %}

{% block title %}Sidebar{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/sidebarUserMap.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/sidebarUserMap.js') }}"></script>
{% endblock %}

{% block body %}

    <h1>Page Sidebar user map</h1>

    <div id="sidebar-trigger-zone" class="trigger-tab">
        <span class="arrow-icon">◀</span>
    </div>

    <div id="sidebar-panel" class="sidebar-container">

        <div class="sidebar-header">
            <div class="header-icon">?</div>
            <h2>PAGE ANNEXE</h2>
        </div>

        <div class="sidebar-body">

            <div class="left-strip">
                <span class="vertical-text">CARTE</span>
                <button id="btn-close-sidebar" class="tab-close">▶</button>
            </div>

            <div class="user-card">
                <h3>UTILISATEUR</h3>

                    $pseudo = "";
                    $score = 0;

                    {% if (isset($currentUser)) %}
                        {
                            {{ form_label(sidebarForm.currentUser, "1. pseudo") }}
                            
                            $pseudo = $currentUser->getUser()->getPseudoUser();
                            $totalScore = $currentUser->getTotalScore();
                            $totalScoreClass = $currentUser->getTotalScoreClasse();

                        }
                    {% endif %}

                <div class="info-group">
                    <span class="label">PSEUDO :</span>
                    <span class="value pseudo"><?= htmlspecialchars($pseudo) ?></span>
                    <span class="label">SCORE TOTAL :</span>
                    <span class="value pseudo"><?= htmlspecialchars($totalScore) ?></span>
                    <span class="label">SCORE CLASSE :</span>
                    <span class="value pseudo"><?= htmlspecialchars($totalScoreClass) ?></span>
                </div>


            </div>
        </div>
    </div>

{% endblock %}