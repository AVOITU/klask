<div id="sidebar-trigger-zone" class="trigger-tab">
    <span class="arrow-icon">◀</span>
</div>

<div id="sidebar-panel" class="sidebar-container">

    <div class="sidebar-main-box">
        
        <button id="btn-close-sidebar" class="tab-close">
            <span>◀</span>
        </button>

        <div class="sidebar-content">
            {% if currentUser and userStats %}
                
                <div class="info-block">
                    <span class="value">{{ currentUser.pseudoUser }}</span>
                </div>

                <div class="avatar-block">
                    <img src="{{ asset('images/' ~ currentUser.pseudoUser ~ '.png') }}" 
                         onerror="this.src='{{ asset('images/coccitest.png') }}'" 
                         alt="Avatar de {{ currentUser.pseudoUser }}" 
                         class="avatar-img">
                </div>

                <div class="info-block school-block">
                    <span class="value">{{ currentUser.group?.establishment?.nameEstablishment|default('ÉTABLISSEMENT') }}</span>
                    <span class="value">{{ currentUser.group?.nameGroup|default('CLASSE') }}</span>
                </div>

                <div class="info-block score-block">
                    <span class="label">SCORE PERSO:</span>
                    <span class="value">{{ userStats.totalScore|default(0) }}</span>
                </div>

                <div class="info-block score-block">
                    <span class="label">SCORE GROUPE:</span>
                    <span class="value">{{ userStats.totalScoreGroup|default(0) }}</span>
                </div>

            {% else %}
                <div class="info-block">
                    <p>Données indisponibles.</p>
                </div>
            {% endif %}

            <div class="footer-block">
                <a href="#" class="mentions-link">MENTIONS LEGALES</a>
            </div>

        </div>
    </div>
</div>