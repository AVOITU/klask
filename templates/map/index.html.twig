{# templates/map/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Carte - Fond de plan{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* On s'assure que le body prend toute la hauteur */
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            background-color: #333; /* Un fond sombre pour faire ressortir la carte */
        }

        .map-wrapper {
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .map-background {
            width: 100%;
            max-width: 600px; /* Limite pour garder un aspect "mobile" sur ordinateur */
            height: 100%;
            /* Utilisation du bon chemin vers assets/images */
            background-image: url('{{ asset("assets/images/Fausse_carte.png") }}');
            background-size: contain; /* L'image sera entièrement visible sans être coupée */
            background-repeat: no-repeat;
            background-position: center;
            background-color: #FFFFFF;
            position: relative;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="map-wrapper">
        <div class="map-background">
            {# C'est ici que nous viendrons ajouter les éléments interactifs plus tard #}
        </div>
    </div>
{% endblock %}