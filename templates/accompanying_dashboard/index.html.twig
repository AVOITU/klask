{% extends 'base.html.twig' %}

{% block title %}Mon Tableau de Bord Accompagnateur - Klask{% endblock %}

{% block body %}
    <div class="container mobile-dashboard py-3" style="max-width: 600px; margin: 0 auto;">

        {# 1. EN-TÊTE DU GROUPE #}
        <div class="card p-3 mb-3 shadow-sm">
            <h2 class="h4">Espace Accompagnateur</h2>
            <p class="text-muted mb-2">Bonjour, <strong>{{ accompanying.pseudo }}</strong></p>

            {% if group %}
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                    {# Grâce au __toString() qu'on a ajouté, {{ group }} affichera directement son nom #}
                    <span>Groupe : <span class="badge bg-dark">{{ group }}</span></span>
                    <span>Score Collectif : <strong class="text-success">{{ totalScore }} pts</strong></span>
                </div>
            {% else %}
                <div class="alert alert-warning m-0">Aucun groupe ne vous est attribué pour le moment.</div>
            {% endif %}
        </div>

        {# 2. LISTE DES ÉLÈVES #}
        <div class="students-section">
            <h4 class="h5 mb-3">Mes Élèves ({{ students|length }})</h4>

            {% for student in students %}
                {# On n'affiche pas l'accompagnateur dans la liste des élèves #}
                {% if student != accompanying %}

                    {# Si l'élève a 3 scans invalides ou plus, on colore sa carte en rouge (Alerte élève bloqué) #}
                    {% set isBlocked = student.blockedUntil and student.blockedUntil > date() %}

                    <div class="card p-3 mb-2 shadow-sm {% if isBlocked or student.invalidScanCount >= 3 %}border-danger bg-light{% endif %}" id="student-{{ student.id }}">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="h6 mb-1">{{ student.pseudo }}</h5>

                                {% if isBlocked or student.invalidScanCount >= 3 %}
                                    <span class="badge bg-danger">Bloqué ({{ student.invalidScanCount }} scans inv.)</span>
                                {% else %}
                                    <span class="badge bg-success">Actif</span>
                                {% endif %}
                            </div>

                            <div class="text-end">
                                <span class="fs-4 fw-bold text-primary">{{ student.score|default(0) }}</span> <small class="text-muted">pts</small>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <p class="text-muted text-center py-4">Aucun élève inscrit dans ce groupe pour le moment.</p>
            {% endfor %}
        </div>

        {# 3. BOUTONS D'ACTIONS (Pour tes prochains tickets) #}
        <div class="d-grid gap-2 mt-4">
            <button class="btn btn-outline-secondary btn-sm">Vue carte enrichie</button>
            <button class="btn btn-primary">Exporter le bilan de la journée (PDF)</button>
        </div>

    </div>
{% endblock %}
