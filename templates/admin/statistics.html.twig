{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Statistiques Globales — AJE29{% endblock %}

{% block content_header %}
    <div class="d-flex justify-content-between align-items-center w-100">
        <h1 class="title">Tableau de Bord — Bilan AJE29</h1>
        <span class="text-muted"><i class="fas fa-calendar-day me-1"></i> Données temps réel</span>
    </div>
{% endblock %}

{% block main %}
    {# ── CRITÈRE 3 : NOMBRE DE DEMANDES DE STAGE / ALTERNANCE ── #}
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 h-100 shadow-sm" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white;">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h6 class="text-uppercase text-white-50 fw-bold mb-1" style="font-size: 0.8rem; letter-spacing: 1px;">
                            Demandes de Stage & Alternance
                        </h6>
                        <h1 class="mb-0 fw-black display-5">{{ stats.internships_count }}</h1>
                    </div>
                    <div class="fs-1 text-white-50 opacity-50">
                        <i class="fas fa-briefcase"></i>
                    </div>
                </div>
            </div>
        </div>

        {# Optionnel : Rappel visuel de la journée #}
        <div class="col-md-8">
            <div class="card border-0 h-100 shadow-sm bg-white p-3 d-flex flex-row align-items-center">
                <div class="p-3 bg-light rounded-circle text-primary me-3">
                    <i class="fas fa-info-circle fa-xl"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1">Suivi de la Gamification</h5>
                    <p class="text-muted mb-0 small">Les scores ci-dessous se basent sur les coefficients de points définis dans tes Catégories d'activités à chaque scan d'élève.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        {# ── CRITÈRE 2.1 : ACTIVITÉS / STANDS LES PLUS VISITÉS ── #}
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between">
                    <h5 class="card-title fw-bold mb-0 text-dark">
                        <i class="fas fa-star text-warning me-2"></i>Top 10 — Stands les plus visités
                    </h5>
                    <span class="badge bg-light text-muted border">Par volume de scans</span>
                </div>
                <div class="card-body px-4">
                    {% if stats.top_activities is empty %}
                        <div class="text-center py-5">
                            <i class="fas fa-qrcode fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">Aucun scan enregistré pour le moment.</p>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                <tr>
                                    <th>Nom du stand / Activité</th>
                                    <th class="text-end" style="width: 120px;">Visites</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for activity in stats.top_activities %}
                                    <tr>
                                        <td class="fw-semibold text-secondary">{{ activity.activity_name }}</td>
                                        <td class="text-end">
                                                <span class="badge bg-primary-dark font-monospace px-3 py-2 fs-6" style="background-color: #f1f5f9; color: #1e293b; border: 1px solid #e2e8f0;">
                                                    {{ activity.scan_count }}
                                                </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── CRITÈRE 2.2 : SPHÈRES LES PLUS POPULAIRES ── #}
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="card-title fw-bold mb-0 text-dark">
                        <i class="fas fa-chart-pie text-info me-2"></i>Popularité des Sphères Métiers
                    </h5>
                </div>
                <div class="card-body px-4">
                    {% if stats.top_spheres is empty %}
                        <div class="text-center py-5">
                            <i class="fas fa-circle-notch fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">Aucune donnée disponible pour le moment.</p>
                        </div>
                    {% else %}
                        <div class="list-group list-group-flush">
                            {% for sphere in stats.top_spheres %}
                                <div class="list-group-item d-flex align-items-center justify-content-between px-0 py-3 border-bottom">
                                    <div class="d-flex align-items-center">
                                        {# Pastille de couleur dynamique tirée directement de la BDD #}
                                        <span class="d-inline-block rounded-circle me-3 shadow-sm"
                                              style="width: 16px; height: 16px; background-color: {{ sphere.color }}; border: 1px solid rgba(0,0,0,0.1);"></span>
                                        <span class="fw-bold text-dark">{{ sphere.sphere_name }}</span>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <span class="text-muted small me-2">{{ sphere.scan_count }} scans</span>
                                        <span class="badge bg-info text-white rounded-pill px-2">
                                            {{ loop.index }}
                                        </span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        {# ── CRITÈRE 4 : SCORES PAR GROUPE ET CLASSEMENT GÉNÉRAL ── #}
        <div class="col-lg-7 mb-4 mb-lg-0">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="card-title fw-bold mb-0 text-dark">
                        <i class="fas fa-trophy text-warning me-2"></i>Classement Général des Groupes
                    </h5>
                </div>
                <div class="card-body px-4">
                    {% if stats.group_ranking is empty %}
                        <div class="text-center py-5">
                            <i class="fas fa-medal fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">Les groupes n'ont pas encore accumulé de points.</p>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-dark">
                                <tr>
                                    <th class="text-center" style="width: 70px;">Rang</th>
                                    <th>Groupe</th>
                                    <th>Établissement</th>
                                    <th class="text-end">Score Global</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for group in stats.group_ranking %}
                                    <tr>
                                        <td class="fw-bold text-center fs-5">
                                            {% if loop.index == 1 %}
                                                🥇
                                            {% elseif loop.index == 2 %}
                                                🥈
                                            {% elseif loop.index == 3 %}
                                                🥉
                                            {% else %}
                                                <span class="text-muted small">#{{ loop.index }}</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="fw-bold text-dark">{{ group.level_name ?: 'Sans Nom' }}</span>
                                            <small class="text-muted d-block font-monospace" style="font-size: 0.75rem;">Code: {{ group.group_code }}</small>
                                        </td>
                                        <td>
                                            <span class="text-secondary"><i class="fa fa-school opacity-50 me-1"></i>{{ group.establishment_name }}</span>
                                        </td>
                                        <td class="text-end fw-bold text-primary fs-5">
                                            {{ group.total_score ?: 0 }} <span class="fs-6 text-muted fw-normal">pts</span>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── CRITÈRE 1 : NOMBRE D'ÉLÈVES INSCRITS, PAR NIVEAU, PAR ÉTABLISSEMENT ── #}
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="card-title fw-bold mb-0 text-dark">
                        <i class="fas fa-user-graduate text-success me-2"></i>Démographie des Élèves Inscrits
                    </h5>
                </div>
                <div class="card-body px-4">
                    {% if stats.students_by_level is empty %}
                        <div class="text-center py-5">
                            <i class="fas fa-users-slash fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">Aucun élève de type "STUDENT" inscrit.</p>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                <tr>
                                    <th>Lycée / Collège</th>
                                    <th>Niveau</th>
                                    <th class="text-end">Effectif</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for row in stats.students_by_level %}
                                    <tr>
                                        <td class="fw-semibold text-dark">{{ row.establishment_name }}</td>
                                        <td>
                                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                                    {{ row.level_name }}
                                                </span>
                                        </td>
                                        <td class="text-end fw-bold text-secondary">{{ row.total_students }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
